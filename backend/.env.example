# Environment variables for the Buzzie backend.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- General ---
# Optional. One of: development | production | test. Default: development
NODE_ENV=development

# Optional. Port the HTTP server listens on. Default: 8000
PORT=8000

# --- Database ---
# Required. MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/buzzie

# --- Authentication ---
# Optional in development (defaults to "secret_jwt"), REQUIRED in production.
# Use a long, random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Access-token lifetime (ms format). Default: 7d
# The token is stored in an httpOnly cookie. See GUIDE.md §7 for the token strategy.
JWT_EXPIRES_IN=7d

# Optional. Exact CORS origin of the frontend. Default: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# --- Redis (optional, for Socket.IO horizontal scaling) ---
# Optional. Leave empty/unset to disable the Redis adapter and Redis health check.
REDIS_URL=

# --- Cloudinary (required for media uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
